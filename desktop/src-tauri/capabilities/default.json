{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Daylight shell window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-is-visible",
    "dialog:default",
    "notification:default",
    "autostart:default",
    "allow-consent-accepted",
    "allow-accept-consent",
    "allow-decline-consent",
    "allow-get-today",
    "allow-get-week",
    "allow-get-apps",
    "allow-get-sun",
    "allow-list-reminders",
    "allow-save-reminder",
    "allow-delete-reminder",
    "allow-test-reminder",
    "allow-get-settings",
    "allow-set-settings",
    "allow-export-data",
    "allow-wipe-data",
    "allow-pause",
    "allow-resume"
  ]
}
